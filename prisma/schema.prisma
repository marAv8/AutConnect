generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         String
  providerRole String?
  authType     String   @default("email")
  createdAt    DateTime @default(now())

  providerClients ProviderClient[]
  goalDefinitions GoalDefinition[]

  entries    Entry[]
  entryReads EntryRead[]
  teamFocusItems TeamFocus[]
  documentationDrafts DocumentationDraft[]

  @@index([createdAt])
}

enum Role {
  Supervisor
  Educator
  SpeechPathologist
  Caregiver
  BehaviorTherapist
  OccupationalTherapist
}

enum MetricType {
  Percentage
  Frequency
  Duration
  Subjective
}

enum ComparisonType {
  LessThan
  GreaterThan
  Equal
}

enum AssessmentDomain {
  Behavior
  SkillAcquisition
  Communication
  Adaptive
  Regulation
  Other
}

enum EntryKind {
  SessionNote
  MorningContext
  EveningContext
  SupervisorObservation
  ClinicalNote
  SensoryObservation
  SpeechProgress
  CommunicationObservation
}

enum EntryVisibility {
  Private
  Shared
}

enum EntryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Client {
  id                            String    @id @default(uuid())
  firstName                     String
  lastName                      String
  dateOfBirth                   DateTime?
  diagnosis                     String?
  receivesPrescribedMedication  Boolean   @default(false)
  createdAt                     DateTime  @default(now())

  providerClients ProviderClient[]
  goalDefinitions GoalDefinition[]

  entries Entry[]
  teamFocusItems TeamFocus[]
  documentationDrafts DocumentationDraft[]

  @@index([createdAt])
}

model TeamFocus {
  id String @id @default(uuid())

  clientId String
  authorId String

  title   String?
  content String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  author Provider @relation(fields: [authorId], references: [id])

  @@index([clientId, isActive])
  @@index([authorId])
  @@index([updatedAt])
}

model ProviderClient {
  id         String @id @default(uuid())
  providerId String
  clientId   String
  role       Role // <-- this is missing right now

  provider Provider @relation(fields: [providerId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  @@index([providerId])
  @@index([clientId])
  @@index([providerId, clientId])
}

model Entry {
  id String @id @default(uuid())

  providerId String
  clientId   String

  date DateTime
  kind EntryKind @default(SessionNote)
  visibility EntryVisibility @default(Shared)
  status EntryStatus @default(IN_PROGRESS)

  q1 Int?
  q2 Int?
  q3 Int?
  q4 Int?
  q5 Int?
  q6 Int?
  q7 Int?

  note               String?
  clinicalReflection String?
  contextData        Json?
  finalScore         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  provider Provider @relation(fields: [providerId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  items AssessmentItem[]
  reads EntryRead[]
  abcObservations AbcObservation[]

  @@unique([providerId, clientId, date, kind])
  @@index([clientId, date])
  @@index([clientId, providerId, date])
  @@index([clientId, kind, date])
  @@index([clientId, visibility, date])
  @@index([date])
  @@index([updatedAt])
}

model AbcObservation {
  id String @id @default(uuid())

  entryId String

  antecedent  String
  behavior    String
  consequence String

  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([createdAt])
}

model AssessmentItem {
  id String @id @default(uuid())

  entryId String
  goalId  String?

  target String
  goal   String

  score Int?

  metricType   MetricType
  domain       AssessmentDomain?
  rawValue     Float?
  supportLevel Int?

  createdAt DateTime @default(now())

  entry          Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  goalDefinition GoalDefinition? @relation(fields: [goalId], references: [id])

  @@index([entryId])
  @@index([goalId])
}

model GoalDefinition {
  id String @id @default(uuid())

  clientId   String
  providerId String

  target String
  goal   String

  metricType MetricType
  domain     AssessmentDomain?
  measurementProfile String?

  targetValue Float?
  comparison  ComparisonType?

  weight Float @default(1.0)

  isActive   Boolean @default(true)
  isMastered Boolean @default(false)

  createdAt DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  items AssessmentItem[]

  @@index([clientId, providerId, isActive, isMastered])
  @@index([providerId])
}

model EntryRead {
  id String @id @default(uuid())

  entryId    String
  providerId String

  readAt DateTime?

  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([entryId, providerId])
  @@index([providerId, entryId])
}

model DocumentationDraft {
  id String @id @default(uuid())

  providerId String
  clientId   String
  workflowKey String

  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([providerId, clientId, workflowKey])
  @@index([clientId, providerId])
  @@index([updatedAt])
}
