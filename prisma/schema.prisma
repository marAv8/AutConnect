generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         String
  providerRole String?
  authType     String         @default("email")
  status       ProviderStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())

  providerClients ProviderClient[]
  goalDefinitions GoalDefinition[]

  entries                          Entry[]
  entryReads                       EntryRead[]
  clientSignalReads                ClientSignalRead[]
  entryRevisions                   EntryRevision[]
  teamFocusItems                   TeamFocus[]
  documentationDrafts              DocumentationDraft[]
  ownedCaseSupportCases            CaseSupportCase[]             @relation("CaseSupportOwner")
  caseSupportMemberships           CaseSupportMember[]           @relation("CaseSupportMemberProvider")
  caseSupportAccessGrants          CaseSupportMember[]           @relation("CaseSupportGrantedBy")
  caseSupportAuditEvents           CaseSupportAuditEvent[]       @relation("CaseSupportAuditActor")
  receivedCaseSupportNotifications CaseSupportNotification[]     @relation("CaseSupportNotificationRecipient")
  sentCaseSupportNotifications     CaseSupportNotification[]     @relation("CaseSupportNotificationActor")
  caseSupportEntries               CaseSupportEntry[]
  caseSupportCoordinations         CaseSupportCoordination[]
  submittedCaseSupportRequests     CaseSupportRequest[]          @relation("CaseSupportRequester")
  receivedCaseSupportRequests      CaseSupportRequest[]          @relation("CaseSupportRecipient")
  organizationMemberships          OrganizationMembership[]
  sentOrganizationInvitations      OrganizationInvitation[]      @relation("OrganizationInvitationSender")
  reviewedAgencyAccessRequests     AgencyAccessRequest[]         @relation("AgencyAccessRequestReviewer")
  authoredFieldObservations        FieldObservation[]            @relation("FieldObservationSupervisor")
  receivedFieldObservations        FieldObservation[]            @relation("FieldObservationObservedProvider")
  requestedClientOrganizations     ClientOrganization[]          @relation("ClientOrganizationRequestedBy")
  approvedClientOrganizations      ClientOrganization[]          @relation("ClientOrganizationApprovedBy")
  revokedClientOrganizations       ClientOrganization[]          @relation("ClientOrganizationRevokedBy")
  clientTeamManagerGrants          ClientTeamManager[]           @relation("ClientTeamManagerProvider")
  grantedClientTeamManagers        ClientTeamManager[]           @relation("ClientTeamManagerGrantedBy")
  revokedClientTeamManagers        ClientTeamManager[]           @relation("ClientTeamManagerRevokedBy")
  assignedClientRelationships      ProviderClient[]              @relation("ProviderClientAssignedBy")
  revokedClientRelationships       ProviderClient[]              @relation("ProviderClientRevokedBy")
  clientTeamAuditEvents            ClientTeamAuditEvent[]        @relation("ClientTeamAuditActor")
  clientTeamAuditSubjects          ClientTeamAuditEvent[]        @relation("ClientTeamAuditSubjectProvider")
  requestedClientAttachRequests    ClientAttachRequest[]         @relation("ClientAttachRequester")
  decidedClientAttachRequests      ClientAttachRequest[]         @relation("ClientAttachDecider")
  clientAttachRateLimitBuckets     ClientAttachRateLimitBucket[]
  clientAttachSecurityEvents       ClientAttachSecurityEvent[]

  @@index([createdAt])
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Role {
  Supervisor
  Educator
  SpeechPathologist
  Caregiver
  BehaviorTherapist
  OccupationalTherapist
}

enum FieldObservationRating {
  IMPLEMENTED
  PARTIALLY_IMPLEMENTED
  NOT_IMPLEMENTED
  NOT_OBSERVED
}

enum FieldObservationSetting {
  CLINIC
  HOME
  SCHOOL
  COMMUNITY
  TELEHEALTH
  OTHER
}

enum OrganizationType {
  AGENCY
  SCHOOL
  DISTRICT
  INDEPENDENT
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ClientOrganizationRole {
  LEAD
  PARTICIPATING
}

enum ClientOrganizationStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ClientTeamAuditAction {
  ORGANIZATION_REQUESTED
  ORGANIZATION_APPROVED
  ORGANIZATION_REVOKED
  TEAM_MANAGER_GRANTED
  TEAM_MANAGER_REVOKED
  PROVIDER_ASSIGNED
  PROVIDER_REVOKED
  PROVIDER_REACTIVATED
  LEAD_ORGANIZATION_CHANGED
  ATTACH_REQUESTED
  ATTACH_APPROVED
  ATTACH_REJECTED
  ATTACH_CANCELLED
}

enum ClientAttachRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ClientAttachSecurityOutcome {
  REQUEST_CREATED
  CASE_CODE_NOT_FOUND
  ALREADY_PARTICIPATING
  PENDING_REQUEST_EXISTS
  UNAUTHORIZED
  RATE_LIMITED
  FAILED_CLOSED
}

model Organization {
  id                   String           @id @default(uuid())
  name                 String
  normalizedName       String           @unique
  type                 OrganizationType
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  parentOrganizationId String?

  memberships                  OrganizationMembership[]
  providerClients              ProviderClient[]
  caseSupportCases             CaseSupportCase[]
  caseSupportRequests          CaseSupportRequest[]
  invitations                  OrganizationInvitation[]
  accessRequests               AgencyAccessRequest[]
  parentOrganization           Organization?                 @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations           Organization[]                @relation("OrganizationHierarchy")
  clientOrganizations          ClientOrganization[]
  clientTeamAuditEvents        ClientTeamAuditEvent[]
  clientAttachRequests         ClientAttachRequest[]
  clientAttachRateLimitBuckets ClientAttachRateLimitBucket[]
  clientAttachSecurityEvents   ClientAttachSecurityEvent[]

  @@index([type, name])
  @@index([parentOrganizationId])
}

model OrganizationMembership {
  id             String                     @id @default(uuid())
  organizationId String
  providerId     String
  role           OrganizationMembershipRole @default(MEMBER)
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId])
  @@index([providerId, active])
}

model OrganizationInvitation {
  id                  String                     @id @default(uuid())
  organizationId      String
  email               String
  normalizedEmail     String
  providerRole        String
  membershipRole      OrganizationMembershipRole @default(MEMBER)
  tokenHash           String                     @unique
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  invitedByProviderId String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Provider     @relation("OrganizationInvitationSender", fields: [invitedByProviderId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail, expiresAt])
  @@index([organizationId, acceptedAt, revokedAt])
}

enum AgencyAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model AgencyAccessRequest {
  id                     String                    @id @default(uuid())
  organizationName       String
  normalizedOrganization String
  organizationType       OrganizationType
  contactFirstName       String
  contactLastName        String
  contactEmail           String
  normalizedEmail        String
  status                 AgencyAccessRequestStatus @default(PENDING)
  reviewedAt             DateTime?
  reviewedByProviderId   String?
  approvedOrganizationId String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  reviewedBy           Provider?     @relation("AgencyAccessRequestReviewer", fields: [reviewedByProviderId], references: [id], onDelete: SetNull)
  approvedOrganization Organization? @relation(fields: [approvedOrganizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([normalizedEmail, status])
  @@index([normalizedOrganization, status])
}

enum MetricType {
  Percentage
  Frequency
  Duration
  Subjective
}

enum ComparisonType {
  LessThan
  GreaterThan
  Equal
}

enum GoalMasteryBasis {
  LEGACY_NORMALIZED
  POLICY_V1
}

enum AssessmentDomain {
  Behavior
  SkillAcquisition
  Communication
  Adaptive
  Regulation
  Other
}

enum EntryKind {
  SessionNote
  MorningContext
  EveningContext
  SupervisorObservation
  ClinicalNote
  SensoryObservation
  SpeechProgress
  CommunicationObservation
}

enum EntryVisibility {
  Private
  Shared
}

enum EntryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Client {
  id                           String    @id @default(uuid())
  caseCode                     String    @unique @default(uuid())
  firstName                    String
  lastName                     String
  dateOfBirth                  DateTime?
  diagnosis                    String?
  receivesPrescribedMedication Boolean   @default(false)
  createdAt                    DateTime  @default(now())

  providerClients ProviderClient[]
  goalDefinitions GoalDefinition[]

  entries               Entry[]
  teamFocusItems        TeamFocus[]
  documentationDrafts   DocumentationDraft[]
  caseSupportCases      CaseSupportCase[]
  caseSupportRequests   CaseSupportRequest[]
  clientSignalReads     ClientSignalRead[]
  fieldObservations     FieldObservation[]
  clientOrganizations   ClientOrganization[]
  teamManagers          ClientTeamManager[]
  clientTeamAuditEvents ClientTeamAuditEvent[]
  attachRequests        ClientAttachRequest[]

  @@index([createdAt])
}

model ClientOrganization {
  id               String                   @id @default(uuid())
  clientId         String
  organizationId   String
  role             ClientOrganizationRole
  status           ClientOrganizationStatus @default(PENDING)
  requestedById    String
  approvedById     String?
  requestedAt      DateTime                 @default(now())
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedById      String?
  revocationReason String?

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  Provider     @relation("ClientOrganizationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy   Provider?    @relation("ClientOrganizationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  revokedBy    Provider?    @relation("ClientOrganizationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([clientId, organizationId])
  @@index([clientId, status])
  @@index([organizationId, status])
}

model ClientTeamManager {
  id          String    @id @default(uuid())
  clientId    String
  providerId  String
  grantedById String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider  Provider  @relation("ClientTeamManagerProvider", fields: [providerId], references: [id], onDelete: Restrict)
  grantedBy Provider  @relation("ClientTeamManagerGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy Provider? @relation("ClientTeamManagerRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([clientId, providerId])
  @@index([providerId, revokedAt])
  @@index([clientId, revokedAt])
}

model ClientTeamAuditEvent {
  id                String                @id @default(uuid())
  clientId          String
  actorId           String
  action            ClientTeamAuditAction
  subjectProviderId String?
  organizationId    String?
  assignmentId      String?
  metadata          Json?
  createdAt         DateTime              @default(now())

  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actor           Provider      @relation("ClientTeamAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  subjectProvider Provider?     @relation("ClientTeamAuditSubjectProvider", fields: [subjectProviderId], references: [id], onDelete: SetNull)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([assignmentId])
}

model ClientAttachRequest {
  id             String                    @id @default(uuid())
  clientId       String
  organizationId String
  requestedById  String
  status         ClientAttachRequestStatus @default(PENDING)
  requestedAt    DateTime                  @default(now())
  decidedById    String?
  decidedAt      DateTime?
  reason         String?
  updatedAt      DateTime                  @updatedAt

  client         Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy    Provider                    @relation("ClientAttachRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      Provider?                   @relation("ClientAttachDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  securityEvents ClientAttachSecurityEvent[]

  @@index([clientId, status, requestedAt])
  @@index([organizationId, status, requestedAt])
  @@index([requestedById, status, requestedAt])
}

model ClientAttachRateLimitBucket {
  id              String   @id @default(uuid())
  providerId      String
  organizationId  String
  bucketStartedAt DateTime
  attemptCount    Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([providerId, organizationId, bucketStartedAt])
  @@index([bucketStartedAt])
}

model ClientAttachSecurityEvent {
  id             String                      @id @default(uuid())
  actorId        String
  organizationId String?
  requestId      String?
  outcome        ClientAttachSecurityOutcome
  createdAt      DateTime                    @default(now())

  actor        Provider             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request      ClientAttachRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model FieldObservation {
  id                   String                  @id @default(uuid())
  clientId             String
  supervisorId         String
  observedProviderId   String
  observedProviderRole Role
  observedAt           DateTime
  setting              FieldObservationSetting
  durationMinutes      Int?
  rubricVersion        String
  fidelityPercent      Int
  applicableItemCount  Int
  strengths            String?
  coachingFocus        String?
  followUp             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               Client                  @relation(fields: [clientId], references: [id])
  supervisor           Provider                @relation("FieldObservationSupervisor", fields: [supervisorId], references: [id])
  observedProvider     Provider                @relation("FieldObservationObservedProvider", fields: [observedProviderId], references: [id])
  items                FieldObservationItem[]

  @@index([clientId, observedAt])
  @@index([supervisorId, observedAt])
  @@index([observedProviderId, observedAt])
}

model FieldObservationItem {
  id                 String                 @id @default(uuid())
  fieldObservationId String
  criterionKey       String
  criterionLabel     String
  rating             FieldObservationRating
  displayOrder       Int
  note               String?
  fieldObservation   FieldObservation       @relation(fields: [fieldObservationId], references: [id], onDelete: Cascade)

  @@unique([fieldObservationId, criterionKey])
  @@index([fieldObservationId, displayOrder])
}

model TeamFocus {
  id String @id @default(uuid())

  clientId String
  authorId String

  title            String?
  content          String
  isActive         Boolean  @default(true)
  displayStartedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client   @relation(fields: [clientId], references: [id])
  author Provider @relation(fields: [authorId], references: [id])

  @@index([clientId, isActive])
  @@index([clientId, isActive, displayStartedAt])
  @@index([authorId])
  @@index([updatedAt])
}

model ProviderClient {
  id               String    @id @default(uuid())
  providerId       String
  clientId         String
  organizationId   String?
  role             Role
  assignedById     String?
  assignedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedById      String?
  revocationReason String?

  provider     Provider      @relation(fields: [providerId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedBy   Provider?     @relation("ProviderClientAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    Provider?     @relation("ProviderClientRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([providerId, clientId])
  @@index([providerId])
  @@index([clientId])
  @@index([providerId, clientId])
  @@index([clientId, organizationId])
}

model Entry {
  id String @id @default(uuid())

  providerId String
  clientId   String

  date       DateTime
  kind       EntryKind       @default(SessionNote)
  visibility EntryVisibility @default(Shared)
  status     EntryStatus     @default(IN_PROGRESS)

  q1 Int?
  q2 Int?
  q3 Int?
  q4 Int?
  q5 Int?
  q6 Int?
  q7 Int?

  note               String?
  clinicalReflection String?
  contextData        Json?
  finalScore         Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  provider Provider @relation(fields: [providerId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  items           AssessmentItem[]
  reads           EntryRead[]
  revisions       EntryRevision[]
  abcObservations AbcObservation[]

  @@unique([providerId, clientId, date, kind])
  @@index([clientId, date])
  @@index([clientId, providerId, date])
  @@index([clientId, kind, date])
  @@index([clientId, visibility, date])
  @@index([date])
  @@index([updatedAt])
}

model EntryRevision {
  id String @id @default(uuid())

  entryId     String
  createdById String

  revisionNumber Int
  snapshot       Json
  changes        Json
  createdAt      DateTime @default(now())

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdBy Provider @relation(fields: [createdById], references: [id])

  @@unique([entryId, revisionNumber])
  @@index([entryId, createdAt])
  @@index([createdById])
}

model AbcObservation {
  id String @id @default(uuid())

  entryId String

  antecedent  String
  behavior    String
  consequence String

  createdAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([createdAt])
}

model AssessmentItem {
  id String @id @default(uuid())

  entryId String
  goalId  String?

  target String
  goal   String

  score Int?

  metricType   MetricType
  domain       AssessmentDomain?
  rawValue     Float?
  supportLevel Int?
  observation  String?

  createdAt DateTime @default(now())

  entry          Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  goalDefinition GoalDefinition? @relation(fields: [goalId], references: [id])

  @@index([entryId])
  @@index([goalId])
}

model GoalDefinition {
  id String @id @default(uuid())

  clientId   String
  providerId String

  target String
  goal   String

  metricType         MetricType
  domain             AssessmentDomain?
  measurementProfile String?

  targetValue Float?
  comparison  ComparisonType?

  weight Float @default(1.0)

  isActive   Boolean @default(true)
  isMastered Boolean @default(false)

  masteryBasis                   GoalMasteryBasis?
  masteredAt                     DateTime?
  masteryEvidenceEntryIds        Json?
  masteryRevokedAt               DateTime?
  masteryRevokedEvidenceEntryIds Json?
  masteryThreshold               Float?
  masteryRequiredSessions        Int               @default(3)

  createdAt DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  items AssessmentItem[]

  @@index([clientId, providerId, isActive, isMastered])
  @@index([providerId])
}

model EntryRead {
  id String @id @default(uuid())

  entryId    String
  providerId String

  readAt DateTime?

  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([entryId, providerId])
  @@index([providerId, entryId])
}

model ClientSignalRead {
  id String @id @default(uuid())

  clientId    String
  providerId  String
  sessionDate DateTime

  readAt DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([clientId, providerId, sessionDate])
  @@index([providerId, sessionDate])
  @@index([clientId, sessionDate])
}

model DocumentationDraft {
  id String @id @default(uuid())

  providerId  String
  clientId    String
  workflowKey String

  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([providerId, clientId, workflowKey])
  @@index([clientId, providerId])
  @@index([updatedAt])
}

enum CaseSupportStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum CaseSupportRequestStatus {
  REQUESTED
  ACKNOWLEDGED
  CASE_OPENED
  DECLINED
}

enum CaseSupportAccessLevel {
  CONTRIBUTOR
  VIEWER
}

enum CaseSupportEntryType {
  PROVIDER_ACCOUNT
  SUPERVISOR_COORDINATION
  CLARIFICATION
}

enum CaseSupportRequestSource {
  CLASSROOM_STAFF
  SCHOOL_ADMINISTRATION
  AGENCY_SUPERVISOR
  SAFETY_NEED
  SELF_INITIATED
  OTHER
  UNCLEAR
}

enum CaseSupportCoverageStatus {
  MAINTAINED
  TEMPORARILY_REASSIGNED
  NOT_MAINTAINED
  UNCLEAR
}

enum CaseSupportCoordinationPath {
  INTERNAL
  EXTERNAL
}

enum CaseSupportCoordinationStatus {
  DOCUMENTED
  AWAITING_RESPONSE
  RESPONSE_RECEIVED
  MONITORING
  FOLLOW_UP_NEEDED
  COMPLETE
}

enum CaseSupportCommunicationMethod {
  EMAIL
  PHONE
  IN_PERSON
  VIRTUAL_MEETING
  WRITTEN_NOTICE
  OTHER
}

enum CaseSupportNotificationType {
  CASE_UPDATE
  CLARIFICATION
  CASE_OPENED
  ACCESS_GRANTED
  CASE_RESOLVED
}

model CaseSupportCase {
  id String @id @default(uuid())

  clientId          String
  ownerSupervisorId String
  organizationId    String?

  title          String
  concern        String
  desiredOutcome String
  status         CaseSupportStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  client              Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerSupervisor     Provider                  @relation("CaseSupportOwner", fields: [ownerSupervisorId], references: [id])
  organization        Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members             CaseSupportMember[]
  auditEvents         CaseSupportAuditEvent[]
  entries             CaseSupportEntry[]
  coordinations       CaseSupportCoordination[]
  originatingRequests CaseSupportRequest[]
  notifications       CaseSupportNotification[]

  @@index([clientId, status, updatedAt])
  @@index([ownerSupervisorId, status])
  @@index([organizationId, status])
}

model CaseSupportNotification {
  id String @id @default(uuid())

  caseId      String
  recipientId String
  actorId     String
  eventType   CaseSupportNotificationType
  eventKey    String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  case      CaseSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recipient Provider        @relation("CaseSupportNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Provider        @relation("CaseSupportNotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventKey])
  @@index([recipientId, readAt, createdAt])
  @@index([caseId, recipientId, readAt])
}

model CaseSupportRequest {
  id String @id @default(uuid())

  clientId              String
  requesterId           String
  recipientSupervisorId String
  linkedCaseId          String?
  organizationId        String?

  concern          String
  requestedSupport String
  title            String?
  occurredAt       DateTime?
  status           CaseSupportRequestStatus @default(REQUESTED)
  responseNote     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  acknowledgedAt    DateTime?
  respondedAt       DateTime?
  requesterViewedAt DateTime?

  client              Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requester           Provider         @relation("CaseSupportRequester", fields: [requesterId], references: [id])
  recipientSupervisor Provider         @relation("CaseSupportRecipient", fields: [recipientSupervisorId], references: [id])
  linkedCase          CaseSupportCase? @relation(fields: [linkedCaseId], references: [id], onDelete: SetNull)
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([recipientSupervisorId, status, createdAt])
  @@index([requesterId, clientId, createdAt])
  @@index([clientId, status])
  @@index([linkedCaseId])
  @@index([organizationId, status])
}

model CaseSupportMember {
  id String @id @default(uuid())

  caseId      String
  providerId  String
  grantedById String

  accessLevel CaseSupportAccessLevel @default(CONTRIBUTOR)
  grantedAt   DateTime               @default(now())
  revokedAt   DateTime?

  case      CaseSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider  Provider        @relation("CaseSupportMemberProvider", fields: [providerId], references: [id])
  grantedBy Provider        @relation("CaseSupportGrantedBy", fields: [grantedById], references: [id])

  @@unique([caseId, providerId])
  @@index([providerId, revokedAt])
  @@index([caseId, revokedAt])
}

model CaseSupportAuditEvent {
  id String @id @default(uuid())

  caseId  String
  actorId String
  action  String
  details Json?

  createdAt DateTime @default(now())

  case  CaseSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor Provider        @relation("CaseSupportAuditActor", fields: [actorId], references: [id])

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model CaseSupportEntry {
  id String @id @default(uuid())

  caseId        String
  authorId      String
  amendsEntryId String?

  entryType       CaseSupportEntryType
  occurredAt      DateTime
  requestSource   CaseSupportRequestSource
  requestedBy     String?
  coverageStatus  CaseSupportCoverageStatus
  durationMinutes Int?
  scheduleImpacts String[]

  whatOccurred      String
  supportProvided   String
  observableOutcome String
  communication     String?
  followUp          String?
  clarification     String?

  createdAt DateTime @default(now())

  case        CaseSupportCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      Provider           @relation(fields: [authorId], references: [id])
  amendsEntry CaseSupportEntry?  @relation("CaseSupportEntryAmendments", fields: [amendsEntryId], references: [id])
  amendments  CaseSupportEntry[] @relation("CaseSupportEntryAmendments")

  @@index([caseId, occurredAt])
  @@index([authorId, createdAt])
  @@index([amendsEntryId])
}

model CaseSupportCoordination {
  id String @id @default(uuid())

  caseId   String
  authorId String

  path       CaseSupportCoordinationPath
  status     CaseSupportCoordinationStatus
  occurredAt DateTime

  contactOrganization String?
  contactRole         String?
  contactName         String?
  communicationMethod CaseSupportCommunicationMethod?

  actionTaken       String
  requestOrDecision String
  responseSummary   String?
  nextStep          String?
  followUpAt        DateTime?

  createdAt DateTime @default(now())

  case   CaseSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author Provider        @relation(fields: [authorId], references: [id])

  @@index([caseId, occurredAt])
  @@index([authorId, createdAt])
  @@index([path, status])
}
